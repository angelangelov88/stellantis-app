# Copy to .env and fill in. Never commit .env.

# Where the app is served from: your Vercel domain in production, or
# http://localhost:3000 for `pnpm start`.
APP_ORIGIN=http://localhost:3000

# The single password that unlocks the app. Use a long, random one.
APP_PASSWORD=

# Secret used to sign the login cookie. Any random string, 16+ characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The psa_car_controller (psacc) instance that talks to the car, reached
# through its authenticated reverse proxy — never psacc's raw port.
PSACC_URL=https://psacc.example.com

# The shared token that proxy requires. Sent as "Authorization: Bearer <token>".
PSACC_TOKEN=

# Optional: pin to one car by VIN. If unset, the first car psacc knows is used.
VEHICLE_VIN=
